{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "allowJs": true,
    "skipLibCheck": true,
    "types": ["vite/client", "node"],
    "paths": { "@/*": ["./src/*"], "cn": ["./src/cn.ts"] }
  },
  "include": ["src", "vite.config.ts", "playwright.config.ts", "tests"]
}
